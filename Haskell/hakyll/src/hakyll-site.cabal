cabal-version:      2.4
name:               hakyll-site
version:            0.1.0.0
build-type:         Simple

executable site
    main-is:          site.hs
    build-depends:    base, hakyll ==4.17.0.0
    default-language: Haskell2010
    ghc-options:      -O1 -threaded -rtsopts "-with-rtsopts=-N"
