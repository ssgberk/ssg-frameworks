{
  "framework": "sveltekit",
  "tests": [{
    "default": {
      "approach": "Realistic",
      "classification": "Micro",
      "framework": "sveltekit",
      "language": "JavaScript",
      "display_name": "sveltekit",
      "notes": "",
      "versus": "javascript"
    }
  }],
  "content": [
    {
      "folder": "src/posts",
      "type": "3minus",
      "extension": "md"
    }
  ],
  "config": [
    {
      "metadata_dateslug": "date",
      "metadata_layout": "",
      "build_command": "npx vite build --logLevel silent",
      "output_folder": "build",
      "output_glob": "posts/*/index.html",
      "cache_folders": [".svelte-kit", "node_modules/.vite"]
    }
  ]
}
