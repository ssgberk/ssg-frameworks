{
  "framework": "observable-framework",
  "tests": [
    {
      "default": {
        "approach": "Realistic",
        "classification": "Micro",
        "framework": "observable-framework",
        "language": "JavaScript",
        "display_name": "observable-framework",
        "notes": "",
        "versus": "javascript"
      }
    }
  ],
  "content": [
    {
      "folder": "src/posts",
      "type": "3minus",
      "extension": "md"
    }
