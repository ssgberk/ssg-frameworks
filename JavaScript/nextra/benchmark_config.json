{
  "framework": "nextra",
  "tests": [{
    "default": {
      "approach": "Realistic",
      "classification": "Micro",
      "framework": "nextra",
      "language": "JavaScript",
      "display_name": "nextra",
      "notes": "",
      "versus": "javascript"
    }
  }],
  "content": [
    {
      "folder": "content/posts",
      "type": "3minus",
      "extension": "md"
    }
