%section.posts#posts
  %h1.page-title Posts
  %ol.post-list
    - Nesta::Page.find_articles.each do |post|
      %li.post-item
        %h2.post-item-title
          %a(href="#{post.abspath}.html")= post.title
        %time.post-item-date(datetime="#{post.date.strftime('%Y-%m-%dT%H:%M:%SZ')}")= post.date.strftime("%Y-%m-%d")
        %p.post-item-summary= post.metadata("summary")
