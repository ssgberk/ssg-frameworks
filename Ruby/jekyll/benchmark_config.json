{
  "framework": "jekyll",
  "tests": [
    {
      "default": {
        "approach": "Realistic",
        "classification": "Micro",
        "framework": "jekyll",
        "language": "Ruby",
        "display_name": "jekyll",
        "notes": "",
        "versus": "ruby"
      }
    }
  ],
  "content": [
    {
      "folder": "_posts",
      "type": "3minus",
      "extension": "md"
    }
  ],
  "config": [
    {
      "metadata_dateslug": "date",
      "metadata_layout": "layout: post",
      "build_command": "bundle exec jekyll build --quiet",
      "build_verbose": "bundle exec jekyll build --verbose",
      "output_folder": "_site",
      "output_glob": "posts/*/index.html",
      "cache_folders": [
        ".jekyll-cache",
        ".jekyll-metadata"
      ]
    }
  ]
}
