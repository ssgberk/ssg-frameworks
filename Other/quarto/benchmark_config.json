{
  "framework": "quarto",
  "tests": [{
    "default": {
      "approach": "Realistic",
      "classification": "Micro",
      "framework": "quarto",
      "language": "TypeScript",
      "display_name": "quarto",
      "notes": "",
      "versus": "typescript"
    }
  }],
  "content": [
    {
      "folder": "posts",
      "type": "3minus",
      "extension": "md"
    }
