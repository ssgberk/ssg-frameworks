{
  "framework": "jigsaw",
  "tests": [
    {
      "default": {
        "approach": "Realistic",
        "classification": "Micro",
        "framework": "Jigsaw",
        "language": "PHP",
        "display_name": "Jigsaw",
        "notes": "",
        "versus": "php"
      }
    }
  ],
  "content": [
    {
      "folder": "source/_posts",
      "type": "3minus",
      "extension": "md"
    }
  ],
  "config": [
    {
      "metadata_dateslug": "date",
      "metadata_layout": "extends: _layouts.post",
      "build_command": "vendor/bin/jigsaw build --quiet",
      "build_verbose": "vendor/bin/jigsaw build -v",
      "output_folder": "build_local",
      "output_glob": "posts/*/index.html",
      "cache_folders": [
        "cache"
      ]
    }
  ]
}
